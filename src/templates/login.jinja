{% extends "base.jinja" %}
{% block main %}
<main class="container">
    <h1>Login</h1>
    <form hx-post="{{ url_for('login') }}" hx-target="body" hx-push-url="true" hx-disabled-elt="fieldset, button">
        <fieldset class="grid">
            <input type="text" name="email_address" placeholder="Email" aria-label="Email" autocomplete="email"/>
            <input type="password" name="password" placeholder="Password" aria-label="Password" autocomplete="current-password"/>
            <button type="submit" class="primary">Login</button>
        </fieldset>
    </form>
</main>
{% endblock %}