{% extends "base.jinja" %}
{% block main %}
<main class="container">
    <h1>{{ worker_details["worker_name"] | e }}</h1>
    <section>
        <ul>
            {% for movie_id, movie_name, release_year, positions in movies %}
            <li>
                <a href="{{ url_for('get_movie', movie_id=movie_id) }}">{{ movie_name | e }} ({{ release_year }})</a> - {{ positions | e }}
            </li>
            {% endfor %}
        </ul>
    </section>
</main>
{% endblock %}
