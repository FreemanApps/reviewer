{% extends "base.jinja" %}
{% block main %}
<main class="container">
    <h1>{{ person_details["person_name"]|e }}</h1>
    {% if current_person_id == person_details["person_id"] %}
    <section>
        <h2>Private Details</h2>
        <div class="grid">
            <p><strong>Email Address:</strong> {{ person_details["email_address"] }}</p>
        </div>
    </section>
    {% endif %}
    <section>
        <h2>Reviews</h2>
        {% if reviews %}
        <ul>
            {% for review_id, review_score, review_date, movie_id, movie_name in reviews %}
            <li>
                <a href="{{ url_for('get_review', movie_id=movie_id, review_id=review_id) }}">{{ review_score }} for {{ movie_name | e }} on {{ review_date }}</a>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <p>None</p>
        {% endif %}
    </section>
    <section>
        <h2>Replies</h2>
        {% if replies %}
        <ul>
            {% for reply_date, review_id, review_score, review_date, reviewer, movie_id, movie_name in replies %}
            <li>
                <a href="{{ url_for('get_review', movie_id=movie_id, review_id=review_id) }}">Reply on {{ reply_date }} to {{ review_score }} from {{ reviewer | e }} for {{ movie_name|e }} on {{ review_date }}</a>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <p>None</p>
        {% endif %}
    </section>
    <section>
        <h2>Statistics</h2>
        {% if statistics %}
        <ul>
            {% for statistic_name, statistic_type, worker_id, worker_name, review_id, review_score, review_date, movie_id, movie_name in statistics %}
            <li>
                {% if statistic_type == 'worker' %}
                    <a href="{{ url_for('get_worker', worker_id=worker_id) }}">{{statistic_name | replace('_', ' ') | title }} - {{ worker_name | e }}</a>
                {% elif statistic_type == 'review' %}
                    <a href="{{ url_for('get_review', movie_id=movie_id, review_id=review_id) }}">{{statistic_name | replace('_', ' ') | title }} - {{ review_score }} for {{ movie_name | e }} on {{ review_date }}</a>
                {% endif %}
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <p>None</p>
        {% endif %}
    </section>
</main>
{% endblock %}