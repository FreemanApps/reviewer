<section>
    <h2>Replies</h2>
    {% for reply_id, reply_content, reply_date, person_id, person_name, has_liked, likes, has_disliked, dislikes in replies %}
    <article>
        <header class="grid">
            <p><strong>User:</strong> <a href="{{ url_for('get_person', person_id=person_id) }}">{{ person_name|e }}</a></p>
            <p><strong>Date:</strong> {{ reply_date }}</p>
        </header>
        <div id="reply-{{ reply_id }}" style="display: flex; justify-content: space-between;">
            <p>{{ reply_content|e }}</p>
            {% if current_person_id == person_id %}
                <div>
                    <button hx-get="/edit-reply" hx-vals='{"reply_id": {{ reply_id }}, "review_id": {{ review_id }}}' hx-target="#reply-{{ reply_id }}" hx-swap="outerHTML" class="primary">Edit</button>
                    <button hx-delete="/reply" hx-vals='{"reply_id": {{ reply_id }}, "review_id": {{ review_id }}}' hx-target="closest section" hx-swap="outerHTML" hx-confirm="Are you sure you want to delete this reply?" class="contrast">Delete</button>
                </div>
            {% endif %}
        </div>
        <footer class="grid">
            {% with has_reacted = has_liked, object = 'reply', object_id = reply_id, reaction_type = 'like', reaction_count = likes %}
                {% include 'reaction-button.jinja' %}
            {% endwith %}
            {% with has_reacted = has_disliked, object = 'reply', object_id = reply_id, reaction_type = 'dislike', reaction_count = dislikes %}
                {% include 'reaction-button.jinja' %}
            {% endwith %}
        </footer>
    </article>
    {% endfor %}
    <form hx-post="/reply" hx-vals='{"review_id": {{ review_id }}}' hx-target="closest section" hx-swap="outerHTML">
        <fieldset role="group">
            <textarea name="reply_content" placeholder="Add a reply"></textarea>
            <button type="submit" class="primary">Add</button>
        </fieldset>
    </form>
</section>