{% extends "base.jinja" %}
{% block main %}
<main class="container">
    <h1>New Review</h1>
    <form hx-post="{{ url_for('create_review', movie_id=movie_id) }}" hx-target="body" hx-push-url="true" hx-swap="outerHTML" hx-disabled-elt="fieldset, button">
        <fieldset>
            <textarea id="review_content" name="review_content" placeholder="Add a review"{% if error and error["form"] %} aria-describedby="form-invalid-helper" aria-invalid="true"{% endif %}>{% if form_data %}{{ form_data['review_content'] | e }}{% endif %}</textarea>
            <label for="review_score"><strong>Score:</strong></label>
            <input id="review_score" type="number" name="review_score"{% if form_data %} value="{{ form_data['review_score'] | e }}"{% endif %}{% if error and error["form"] %} aria-describedby="form-invalid-helper" aria-invalid="true"{% elif error and error["review_score"] %} aria-describedby="review-score-invalid-helper" aria-invalid="true"{% endif %}>
            {% if error and error["review_score"] %}
                <small id="review-score-invalid-helper">{{ error["review_score"] }}</small>
            {% endif %}
            {% if error and error["form"] %}
                <small id="form-invalid-helper">{{ error["form"] }}</small>
            {% endif %}
            <button type="submit" class="primary">Add</button>
        </fieldset>
    </form>
</main>
{% endblock %}
