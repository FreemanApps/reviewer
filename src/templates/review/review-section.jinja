<section>
    <h2>Details</h2>
    <article>
        <header class="grid">
            <p><strong>User:</strong> <a href="{{ url_for('get_person', person_id=review_details['person_id']) }}">{{ review_details["person_name"]|e }}</a></p>
            <p><strong>Date:</strong> {{ review_details["review_date"] }}</p>
        </header>
        <div id="review-body" style="display: flex; justify-content: space-between;">
            <div>
                <p>{{ review_details["review_content"]|e }}</p>
                <p><strong>Score:</strong> {{ review_details["review_score"] }}</p>
            </div>
            {% if current_person_id == review_details['person_id'] %}
                <div>
                    <button hx-get="/edit-review" hx-vals='{"review_id": {{ review_details["review_id"] }}}' hx-target="#review-body" hx-swap="outerHTML" class="primary">Edit</button>
                    <button hx-delete="/review/{{ review_details['review_id'] }}" hx-target="body" hx-push-url="true" hx-swap="outerHTML" hx-confirm="Are you sure you want to delete this review?" class="contrast">Delete</button>
                </div>
            {% endif %}
        </div>
        <footer class="grid">
            {% with has_reacted = review_details["has_liked"], object = 'review', object_id = review_details["review_id"], reaction_type = 'like', reaction_count = review_details["likes"] %}
                {% include 'review/reaction-button.jinja' %}
            {% endwith %}
            {% with has_reacted = review_details["has_disliked"], object = 'review', object_id = review_details["review_id"], reaction_type = 'dislike', reaction_count = review_details["dislikes"] %}
                {% include 'review/reaction-button.jinja' %}
            {% endwith %}
        </footer>
    </article>
</section>