<section>
    <h2>Details</h2>
    <article>
        <header class="grid">
            <p><strong>User:</strong> <a href="{{ url_for('get_person', person_id=review_details['person_id']) }}">{{ review_details["person_name"] | e }}</a></p>
            <p><strong>Date:</strong> {{ review_details["review_date"] }}</p>
        </header>
        <div id="review-body" style="display: flex; justify-content: space-between;">
            <div>
                {%if review_details["review_content"] %}
                    <p>{{ review_details["review_content"] | e }}</p>
                {% endif %}
                {%if review_details["review_score"] %}
                    <p><strong>Score:</strong> {{ review_details["review_score"] }}</p>
                {% endif %}
            </div>
            {% if current_person_id == review_details['person_id'] %}
                <div>
                    <button hx-get="{{ url_for('get_editable_review', movie_id=movie_id, review_id=review_details['review_id']) }}" hx-target="#review-body" hx-swap="outerHTML" hx-disabled-elt="fieldset, button" class="primary">Edit</button>
                    <button hx-delete="{{ url_for('delete_review', movie_id=movie_id, review_id=review_details['review_id']) }}" hx-target="body" hx-push-url="true" hx-swap="outerHTML" hx-confirm="Are you sure you want to delete this review?" hx-disabled-elt="fieldset, button" class="contrast">Delete</button>
                </div>
            {% endif %}
        </div>
        <footer class="grid">
            {% with has_reacted = review_details["has_liked"], url = url_for('create_review_reaction', movie_id=movie_id, review_id=review_details["review_id"]), object_id = review_details["review_id"], reaction_type = 'like', reaction_count = review_details["likes"] %}
                {% include 'review/reaction-button.jinja' %}
            {% endwith %}
            {% with has_reacted = review_details["has_disliked"], url = url_for('create_review_reaction', movie_id=movie_id, review_id=review_details["review_id"]), reaction_type = 'dislike', reaction_count = review_details["dislikes"] %}
                {% include 'review/reaction-button.jinja' %}
            {% endwith %}
        </footer>
    </article>
</section>