<section>
    <h2>Replies</h2>
    {% for reply_id, reply_content, reply_date, person_id, person_name, has_liked, likes, has_disliked, dislikes in replies %}
    <article>
        <header class="grid">
            <p><strong>User:</strong> <a href="{{ url_for('get_person', person_id=person_id) }}">{{ person_name|e }}</a></p>
            <p><strong>Date:</strong> {{ reply_date }}</p>
        </header>
        <div id="reply-{{ reply_id }}-body" style="display: flex; justify-content: space-between;">
            <p>{{ reply_content|e }}</p>
            {% if current_person_id == person_id %}
                <div>
                    <button hx-get="{{ url_for('get_editable_reply', movie_id=movie_id, review_id=review_id, reply_id=reply_id) }}" hx-target="#reply-{{ reply_id }}-body" hx-swap="outerHTML" hx-disabled-elt="fieldset, button" class="primary">Edit</button>
                    <button hx-delete="{{ url_for('delete_reply', movie_id=movie_id, review_id=review_id, reply_id=reply_id) }}" hx-target="closest section" hx-swap="outerHTML" hx-confirm="Are you sure you want to delete this reply?" hx-disabled-elt="fieldset, button" class="contrast">Delete</button>
                </div>
            {% endif %}
        </div>
        <footer class="grid">
            {% with has_reacted = has_liked, url = url_for('create_reply_reaction', movie_id=movie_id, review_id=review_id, reply_id=reply_id), reaction_type = 'like', reaction_count = likes %}
                {% include 'review/reaction-button.jinja' %}
            {% endwith %}
            {% with has_reacted = has_disliked, url = url_for('create_reply_reaction', movie_id=movie_id, review_id=review_id, reply_id=reply_id), reaction_type = 'dislike', reaction_count = dislikes %}
                {% include 'review/reaction-button.jinja' %}
            {% endwith %}
        </footer>
    </article>
    {% endfor %}
    <form hx-post="{{ url_for('create_reply', movie_id=movie_id, review_id=review_id) }}" hx-target="closest section" hx-swap="outerHTML" hx-disabled-elt="fieldset, button">
        <fieldset role="group">
            <textarea name="reply_content" placeholder="Add a reply"></textarea>
            <button type="submit" class="primary">Add</button>
        </fieldset>
    </form>
</section>