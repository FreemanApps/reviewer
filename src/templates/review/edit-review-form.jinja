<form hx-patch="/review" hx-vals='{"review_id": {{ review_id }}}' hx-target="closest section" hx-swap="outerHTML">
    <textarea name="review_content">{{ review_details["review_content"]|e }}</textarea>
    <label><strong>Score:</strong><input type="number" name="review_score" value="{{ review_details['review_score'] }}"></label>
    <button type="submit" class="primary">Save</button>
</form>