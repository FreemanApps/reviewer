{% if not has_reacted%}
    <div class="grid">
        <button hx-post="{{ url }}" hx-vals='{"reaction_type": "{{ reaction_type }}"}' hx-target="closest div" hx-swap="outerHTML" hx-disabled-elt="fieldset, button" class="primary">{{ reaction_type | capitalize }}</button>
        <p><strong>{{ reaction_type | capitalize }}s:</strong> {{ reaction_count }}</p>
    </div>
{% else %}
    <div class="grid">
        <button hx-delete="{{ url }}" hx-vals='{"reaction_type": "{{ reaction_type }}"}' hx-target="closest div" hx-swap="outerHTML" hx-disabled-elt="fieldset, button" class="secondary">{{ reaction_type | capitalize }}d</button>
        <p><strong>{{ reaction_type | capitalize }}s:</strong> {{ reaction_count }}</p>
    </div>
{% endif %}