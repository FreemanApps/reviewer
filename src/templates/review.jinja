{% extends "base.jinja" %}
{% block main %}
<main class="container">
    <h1>Review</h1>
    <section>
        <h2>Details</h2>
        <article>
            <header class="grid">
                <p><strong>User:</strong> <a href="{{ url_for('get_person', person_id=review_details['person_id']) }}">{{ review_details["person_name"]|e }}</a></p>
                <p><strong>Date:</strong> {{ review_details["review_date"] }}</p>
                <p><strong>Score:</strong> {{ review_details["review_score"] }}</p>
                <p><strong>Likes:</strong> {{ review_details["likes"] }}</p>
                <p><strong>Dislikes:</strong> {{ review_details["dislikes"] }}</p>
            </header>
            {{ review_details["review_content"]|e }}
        </article>
    </section>
    <section>
        <h2>Replies</h2>
        {% for reply_content, reply_date, person_id, person_name, likes, dislikes in replies %}
        <article>
            <header class="grid">
                <p><strong>User:</strong> <a href="{{ url_for('get_person', person_id=person_id) }}">{{ person_name|e }}</a></p>
                <p><strong>Date:</strong> {{ reply_date }}</p>
                <p><strong>Likes:</strong> {{ likes }}</p>
                <p><strong>Dislikes:</strong> {{ dislikes }}</p>
            </header>
            {{ reply_content|e }}
        </article>
        {% endfor %}
    </section>
</main>
{% endblock %}
