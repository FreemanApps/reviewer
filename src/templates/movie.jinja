{% extends "base.jinja" %}
{% block body %}
<h1>{{ movie_details[0]|e }}</h1>
<h2>Details</h2>
<p><strong>Release Date:</strong> {{ movie_details[1] }}</p>
<h2>Cast & Crew</h2>
<ul>
    {% for worker_position, worker_id, worker_name in workers %}
    <li>
        {{ worker_position|e }} - <a href="{{ url_for('get_worker', worker_id=worker_id) }}">{{ worker_name|e }}</a>
    </li>
    {% endfor %}
</ul>
<h2>Genres</h2>
<ul>
    {% for genre_id, genre_name in genres %}
    <li>
        <a href="{{ url_for('get_genre', genre_id=genre_id) }}">{{ genre_name|e }}</a>
    </li>
    {% endfor %}
</ul>
<h2>Reviews</h2>
{% if reviews %}
<ul>
    {% for review_id, review_score, review_date, review_time, reviewer in reviews %}
    <li>
        <a href="{{ url_for('get_review', review_id=review_id) }}">{{ review_score }} from {{ reviewer|e }} on {{ review_date }} at {{ review_time }}</a>
    </li>
    {% endfor %}
</ul>
{% else %}
<p>None</p>
{% endif %}
{% endblock %}
