{% extends "base.jinja" %}
{% block main %}
<main class="container">
    <h1>{{ movie_details["movie_name"] | e }}</h1>
    <section>
        <h2>Details</h2>
        <p><strong>Release Date:</strong> {{ movie_details["release_year"] }}</p>
    </section>
    <section>
        <h2>Cast & Crew</h2>
        <ul>
            {% for worker_id, worker_name, positions in workers %}
            <li>
                <a href="{{ url_for('get_worker', worker_id=worker_id) }}">{{ worker_name | e }}</a> - {{ positions | title }} 
            </li>
            {% endfor %}
        </ul>
    </section>
    <section>
        <h2>Genres</h2>
        <ul>
            {% for genre_id, genre_name in genres %}
            <li>
                <a href="{{ url_for('get_genre', genre_id=genre_id) }}">{{ genre_name | e }}</a>
            </li>
            {% endfor %}
        </ul>
    </section>
    <section>
        <h2>Reviews</h2>
        <p><strong>Average Rating:</strong> {% if reviews_details["average_review_score"] %}{{ reviews_details["average_review_score"] }}{% else %}N/A{% endif %}</p>
        <p><button hx-get="{{ url_for('get_new_review_form', movie_id=movie_details['movie_id']) }}" hx-target="body" hx-push-url="true" hx-swap="outerHTML" class="primary">Add Review</button></p>
        {% if reviews %}
        <ul>
            {% for review_id, review_score, review_date, reviewer in reviews %}
            <li>
                <a href="{{ url_for('get_review', movie_id=movie_details['movie_id'], review_id=review_id) }}">{{ review_score }} from {{ reviewer | e }} on {{ review_date }}</a>
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </section>
</main>
{% endblock %}
